+// Destiny 1: trace of occlusion queries and predication (env D1_OQ_TRACE = lines to write).
+static u64 oq_trace_draws = 0;
+template <typename... Args>
+static void OqTrace(fmt::format_string<Args...> f, Args&&... args) {
+    static int left = [] {
+        const char* e = std::getenv("D1_OQ_TRACE");
+        return e ? std::atoi(e) : 0;
+    }();
+    static FILE* out = left > 0 ? std::fopen("oq-trace.txt", "w") : nullptr;
+    if (!out || left <= 0) {
+        return;
+    }
+    --left;
+    const auto line = fmt::format(f, std::forward<Args>(args)...);
+    std::fputs(line.c_str(), out);
+    std::fputc(10, out);
+    if (left == 0) {
+        std::fclose(out);
+        out = nullptr;
+    }
+}
