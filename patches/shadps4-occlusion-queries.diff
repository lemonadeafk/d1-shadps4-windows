+void Rasterizer::BeginOcclusionQuery(VAddr results) {
+    if (!instance.IsHostQueryResetSupported()) {
+        return;
+    }
+    if (!occlusion_pool) {
+        auto [pool_result, pool] = instance.GetDevice().createQueryPoolUnique({
+            .queryType = vk::QueryType::eOcclusion,
+            .queryCount = NumOcclusionQueries,
+        });
+        if (pool_result != vk::Result::eSuccess) {
+            return;
+        }
+        occlusion_pool = std::move(pool);
+        instance.GetDevice().resetQueryPool(*occlusion_pool, 0, NumOcclusionQueries);
+    }
+    PollOcclusionQueries();
+    if (occlusion_pending.size() >= NumOcclusionQueries - 1) {
+        // The oldest slot is about to be reused: its result is given up
+        occlusion_pending.pop_front();
+    }
+    occlusion_active = results;
+    occlusion_slot = occlusion_next;
+    occlusion_next = (occlusion_next + 1) % NumOcclusionQueries;
+    occlusion_counted = false;
+    instance.GetDevice().resetQueryPool(*occlusion_pool, occlusion_slot, 1);
+}
+
+void Rasterizer::EndOcclusionQuery(VAddr results) {
+    if (occlusion_active == 0) {
+        return;
+    }
+    if (occlusion_counted && results == occlusion_active) {
+        occlusion_pending.push_back({occlusion_active, occlusion_slot});
+    }
+    // (a query without a draw - filtered out, or no pipeline - leaves the last result as it is)
+    occlusion_active = 0;
+    occlusion_counted = false;
+}
+
+void Rasterizer::PollOcclusionQueries() {
+    while (!occlusion_pending.empty()) {
+        const auto& query = occlusion_pending.front();
+        std::array<u64, 2> data{};
+        const auto result = instance.GetDevice().getQueryPoolResults(
+            *occlusion_pool, query.slot, 1, sizeof(data), data.data(), sizeof(data),
+            vk::QueryResultFlagBits::e64 | vk::QueryResultFlagBits::eWithAvailability);
+        if (result != vk::Result::eSuccess || data[1] == 0) {
+            break; // not executed yet; the later ones are not either
+        }
+        occlusion_results[query.results] = data[0];
+        occlusion_pending.pop_front();
+    }
+}
+
+std::optional<u64> Rasterizer::OcclusionResult(VAddr results) {
+    if (!occlusion_pool) {
+        return std::nullopt;
+    }
+    PollOcclusionQueries();
+    const auto it = occlusion_results.find(results);
+    return it != occlusion_results.end() ? std::optional<u64>{it->second} : std::nullopt;
+}
