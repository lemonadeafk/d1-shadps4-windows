@@ -0,0 +1,24 @@
+// Decode / re-encode a large object payload via files (Windows caps command-line length).
+//   object_file decode <tag> <payload in> <image out>
+//   object_file encode <tag> <image in> <payload out>   (refuses unless it round-trips)
+fn main() {
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let tag = u32::from_str_radix(a[1].trim_start_matches("0x"), 16).unwrap();
+    let mut o = d1_oracle::object::ObjectOracle::new(tag).expect("oracle");
+    let input = std::fs::read(&a[2]).expect("read");
+    match a[0].as_str() {
+        "decode" => {
+            let d = o.decode(&input).expect("decode");
+            std::fs::write(&a[3], &d.object).unwrap();
+            println!("decoded {} bits -> {} bytes", d.bits, d.object.len());
+        }
+        "encode" => {
+            let e = o.encode(&input, 0x10_0000).expect("encode");
+            let back = o.decode(&e.payload).expect("re-decode").object;
+            assert!(back == input, "round trip differs - refusing to write");
+            std::fs::write(&a[3], &e.payload).unwrap();
+            println!("encoded {} bits -> {} bytes, round trip identical", e.bits, e.payload.len());
+        }
+        _ => panic!("decode|encode"),
+    }
+}
diff --git a/d1-server/crates/d1-oracle/examples/sensor_frame.rs b/d1-server/crates/d1-oracle/examples/sensor_frame.rs
