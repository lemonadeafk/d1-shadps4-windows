+/// Kinds named by `D1_AH_SENSOR_KIND_RESEQ` (see where the alternate frames are built).
+fn reseq_kinds() -> Vec<u8> {
+    std::env::var("D1_AH_SENSOR_KIND_RESEQ")
+        .map(|v| v.split(',').filter_map(|k| k.trim().parse().ok()).collect())
+        .unwrap_or_default()
+}
+
+fn sensor_init_manifest(bubble: Option<usize>, alt: bool) -> Vec<d1_oracle::sensor::SensorInitEntry> {
+    let mut out = Vec::new();
+    let (path, text) = match std::env::var("D1_AH_SENSOR_INIT") {
+        Ok(path) => match std::fs::read_to_string(&path) {
+            Ok(t) => (path, t),
+            Err(e) => {
+                tracing::error!("⛔ D1_AH_SENSOR_INIT={path}: {e} - sending the phase entry alone");
+                return Vec::new();
+            }
+        },
+        // No measured file: derive the slots from content (every slot but the lifetime record,
+        // which the phase entry itself carries).
+        Err(_) => {
+            if let Some(w) = derived_world_sensors(bubble) {
+                out.extend(
+                    w.slots
+                        .iter()
+                        .filter(|s| s.kind != d1_oracle::world_sensors::KIND_LIFETIME)
+                        .map(|s| d1_oracle::sensor::SensorInitEntry {
+                            name_hash: s.name_hash,
+                            name_i8: s.kind,
+                            name_sub: s.sub,
+                            has_part2: s.part2_tag.is_some(),
+                            value: None,
+                            no_value_part: s.value_tag == u32::MAX,
+                        }),
+                );
+            }
+            (String::new(), String::new())
+        }
+    };
+    let num = |s: &str| -> Option<i64> {
+        match s.strip_prefix("0x") {
+            Some(h) => i64::from_str_radix(h, 16).ok(),
+            None => s.parse().ok(),
+        }
+    };
+    for (n, line) in text.lines().enumerate() {
+        let line = line.split('#').next().unwrap_or("").trim();
+        if line.is_empty() {
+            continue;
+        }
+        let f: Vec<Option<i64>> = line.split_whitespace().map(num).collect();
+        match f.as_slice() {
+            [Some(h), Some(i), Some(sub), Some(p2)] => out.push(d1_oracle::sensor::SensorInitEntry {
+                name_hash: *h as u32,
+                name_i8: *i as u8,
+                name_sub: *sub as i16,
+                has_part2: *p2 != 0,
+                value: None,
+                no_value_part: false,
+            }),
+            _ => tracing::error!("⛔ D1_AH_SENSOR_INIT={path} line {}: want `hash i8 sub part2`", n + 1),
+        }
+    }
+    // ⭐ `D1_AH_SENSOR_PLAYER_SLOT=<sub>[:<owner>]`: that kind-12 player slot (i8 12) is sent with
+    // a real value assigning it to `owner` (default: the profile SOID the BAP side serves,
+    // 0xD100000000000201) - the activity host's job of seating the player, which the client's
+    // spawn gate and rung-34 task 9 wait for.
+    if let Ok(spec) = std::env::var("D1_AH_SENSOR_PLAYER_SLOT") {
+        let mut it = spec.split(':');
+        // `auto` = the world's first player slot
+        let sub = match it.next() {
+            Some("auto") => out.iter().find(|e| e.name_i8 == 12).map(|e| e.name_sub),
+            other => other.and_then(num).map(|v| v as i16),
+        };
+        let owner = it.next().and_then(|o| match o.trim().strip_prefix("0x") {
+            Some(h) => u64::from_str_radix(h, 16).ok(),
+            None => o.trim().parse().ok(),
+        });
+        let owner = owner.unwrap_or(0xD100_0000_0000_0201);
+        match sub.and_then(|sub| out.iter_mut().find(|e| e.name_i8 == 12 && e.name_sub == sub)) {
+            Some(e) => {
+                e.value = Some((
+                    d1_oracle::sensor::TAG_PLAYER_SLOT_VALUE,
+                    // `D1_AH_SENSOR_PLAYER_TEAM`: the team index the slot carries (must equal the
+                    // client's own; 0 in the Tower, -1 in a story mission).
+                    d1_oracle::sensor::player_slot_value(
+                        owner,
+                        std::env::var("D1_AH_SENSOR_PLAYER_TEAM")
+                            .ok()
+                            .and_then(|v| v.trim().parse().ok())
+                            .unwrap_or(0),
+                    ),
+                ));
+                tracing::info!(
+                    "⭐ D1_AH_SENSOR_PLAYER_SLOT: player slot sub {} assigned to owner {owner:#018x}",
+                    e.name_sub
+                );
+            }
+            None => tracing::error!(
+                "⛔ D1_AH_SENSOR_PLAYER_SLOT={spec}: no i8-12 entry with that sub in the manifest"
+            ),
+        }
+    }
+    // ⭐ `D1_AH_SENSOR_KIND_VALUE=<kind>:<tag>:<image file>[,...]` (experiment): every slot of
+    // that kind is sent with this value image instead of the bare default. Used to probe what a
+    // record class does with host state - e.g. squad members (kind 2, 0x80800868), whose setter
+    // FUN_001BE5F0 spawns the actor when value+6 is set and value+5 is 0 or 2 (FUN_001BE9B0).
+    // ⭐ `D1_AH_SENSOR_KIND_SKIP=<kind>@<bubble>[,...]`: in that bubble the kind keeps its bare
+    // default instead of the KIND_VALUE image - e.g. `2@3`: the Wall's squads do not spawn when
+    // the player walks in; the mission script brings them in on its own cues.
+    let here = bubble.unwrap_or_else(initial_bubble);
+    let skipped: Vec<u8> = std::env::var("D1_AH_SENSOR_KIND_SKIP")
+        .map(|v| {
+            v.split(',')
+                .filter_map(|item| {
+                    let (k, b) = item.trim().split_once('@')?;
+                    (b.trim().parse::<usize>().ok()? == here).then(|| k.trim().parse().ok()).flatten()
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    // ⭐ `D1_AH_SENSOR_SLOT_VALUE=<group hex>:<sub>:<tag hex>:<image file>[,...]`: ONE record
+    // carries this value from the area's first frame on (wins over KIND_VALUE). Used to serve a
+    // scripted object in its mission state at arrival - e.g. the gate into the Wall's dark room
+    // already removed, instead of a script opening it once the host's arrival frames are over.
+    if let Ok(spec) = std::env::var("D1_AH_SENSOR_SLOT_VALUE") {
+        for item in spec.split(',') {
+            let f: Vec<&str> = item.splitn(4, ':').collect();
+            let parsed = match f.as_slice() {
+                [g, sub, t, path] => (|| {
+                    Some((
+                        u32::from_str_radix(g.trim().trim_start_matches("0x"), 16).ok()?,
+                        sub.trim().parse::<i16>().ok()?,
+                        u32::from_str_radix(t.trim().trim_start_matches("0x"), 16).ok()?,
+                        std::fs::read(path.trim()).ok()?,
+                    ))
+                })(),
+                _ => None,
+            };
+            let Some((group, sub, tag, image)) = parsed else {
+                tracing::error!("⛔ D1_AH_SENSOR_SLOT_VALUE: cannot use `{item}` (want group:sub:tag:file)");
+                continue;
+            };
+            for e in out.iter_mut().filter(|e| e.name_hash == group && e.name_sub == sub) {
+                e.value = Some((tag, image.clone()));
+                tracing::info!("⭐ D1_AH_SENSOR_SLOT_VALUE: {group:08x}:{sub} carries a {}-byte value of {tag:#010x}", image.len());
+            }
+        }
+    }
+    if let Ok(spec) = std::env::var("D1_AH_SENSOR_KIND_VALUE") {
+        for item in spec.split(',') {
+            if item.split(':').next().and_then(|k| k.trim().parse::<u8>().ok()).is_some_and(|k| skipped.contains(&k)) {
+                tracing::info!("D1_AH_SENSOR_KIND_SKIP: bubble {here} keeps the default for `{item}`");
+                continue;
+            }
+            let f: Vec<&str> = item.splitn(3, ':').collect();
+            let parsed = match f.as_slice() {
+                [k, t, path] => k.trim().parse::<u8>().ok().zip(
+                    u32::from_str_radix(t.trim().trim_start_matches("0x"), 16).ok(),
+                ).zip(std::fs::read(path.trim()).ok()),
+                _ => None,
+            };
+            match parsed {
+                Some(((kind, tag), image)) => {
+                    let mut n = 0;
+                    let mut image = image;
+                    if alt && reseq_kinds().contains(&kind) && image.len() >= 4 {
+                        image[..4].copy_from_slice(&1u32.to_le_bytes());
+                    }
+                    for e in out.iter_mut().filter(|e| e.name_i8 == kind && e.value.is_none()) {
+                        e.value = Some((tag, image.clone()));
+                        n += 1;
+                    }
+                    tracing::info!(
+                        "⭐ D1_AH_SENSOR_KIND_VALUE: {n} kind-{kind} slots carry a {}-byte value of {tag:#010x}",
+                        image.len()
+                    );
+                }
+                None => tracing::error!("⛔ D1_AH_SENSOR_KIND_VALUE: cannot use `{item}` (want kind:tag:file)"),
+            }
+        }
+    }
+    out
+}
+
+/// The bubble the activity starts in: the optional second part of `D1_AH_SENSOR_WORLD=<tag>:<bubble>`.
+fn initial_bubble() -> usize {
+    std::env::var("D1_AH_SENSOR_WORLD")
+        .ok()
+        .and_then(|s| s.split(':').nth(1).and_then(|b| b.trim().parse().ok()))
+        .unwrap_or(0)
+}
+
+/// ⭐ `D1_AH_SENSOR_WORLD=<world record tag>[:<initial bubble>]`: derive the world's sensor slots
+/// from its packages (`$D1_PKGDIR`) instead of a measured manifest - the init entries, the
+/// lifetime record's name and the player slots. Derived once (≈8 s for the Tower).
+fn derived_world_sensors(bubble: Option<usize>) -> Option<&'static d1_oracle::world_sensors::WorldSensors> {
+    static CELL: std::sync::Mutex<
+        std::collections::BTreeMap<usize, Option<&'static d1_oracle::world_sensors::WorldSensors>>,
+    > = std::sync::Mutex::new(std::collections::BTreeMap::new());
+    let spec = std::env::var("D1_AH_SENSOR_WORLD").ok()?;
+    let mut it = spec.split(':');
+    let tag = u32::from_str_radix(it.next()?.trim().trim_start_matches("0x"), 16).ok()?;
+    let initial: usize = it.next().and_then(|b| b.trim().parse().ok()).unwrap_or(0);
+    let bubble = bubble.unwrap_or(initial);
+    let mut cell = CELL.lock().ok()?;
+    *cell.entry(bubble).or_insert_with(|| {
+        match d1_oracle::world_sensors::derive_cached(tag, bubble) {
+            Ok(w) => {
+                tracing::info!(
+                    "⭐ D1_AH_SENSOR_WORLD={tag:#010x} bubble {bubble}: {} sensor slots in groups {:x?}                      derived from content (checksum {:#010x}, lifetime {:x?})",
+                    w.slots.len(),
+                    w.group_hashes,
+                    w.checksum,
+                    w.lifetime().map(|l| (l.name_hash, l.kind, l.sub))
+                );
+                Some(&*Box::leak(Box::new(w)))
+            }
+            Err(e) => {
+                tracing::warn!("D1_AH_SENSOR_WORLD={tag:#010x} bubble {bubble}: {e} - no derived sensor slots");
+                None
+            }
+        }
+    })
+}
