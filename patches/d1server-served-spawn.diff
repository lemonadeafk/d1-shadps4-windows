+// Print a world's sensor manifest derived from content, in D1_AH_SENSOR_INIT format.
+//   world_sensors <world tag> [initial bubble]
+fn main() {
+    let mut a = std::env::args().skip(1);
+    let world = u32::from_str_radix(a.next().expect("world tag").trim_start_matches("0x"), 16).unwrap();
+    let bubble: usize = a.next().map_or(0, |s| s.parse().unwrap());
+    let mut c = d1_oracle::oodle::Content::open_default().expect("content");
+    let w = d1_oracle::world_sensors::derive(&mut c, world, bubble).expect("derive");
+    println!("# world {world:#010x} checksum {:#010x}", w.checksum);
+    println!("# bubbles {:x?}", w.bubble_hashes);
+    println!("# groups {:x?}", w.group_hashes);
+    println!("# lifetime {:x?}", w.lifetime());
+    println!("# hash kind sub part2  (value tag)");
+    for s in &w.slots {
+        println!("{:#010x} {} {} {}  # {:#010x}", s.name_hash, s.kind, s.sub, u8::from(s.part2_tag.is_some()), s.value_tag);
+    }
+}
