@@ -0,0 +1,79 @@
+// Build one udt-5 sensor_auth_update payload that sets values on named sensor slots.
+//
+//   sensor_frame <world tag> <bubble> <out file> <entry>...
+//   entry = <group hash>:<sub>:<value image hex>     (kind, value tag and part 2 come from content)
+//   entry = <group hash>:<sub>                       (default-init only)
+//   entry = @<file>                                  (entries, one per line)
+//
+// The frame also carries the lifetime phase entry (phase 3, same value the host already sent), so
+// it is a valid frame on its own. Drop the output into the activity host's
+// D1_AH_SENSOR_INJECT_DIR as <name>.udt5 to send it to a running client.
+use d1_oracle::sensor::{SensorInitEntry, SensorPhaseUpdate};
+
+fn hex(s: &str) -> u32 {
+    u32::from_str_radix(s.trim_start_matches("0x"), 16).expect("hex")
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    if a.len() < 3 {
+        eprintln!("usage: sensor_frame <world tag> <bubble> <out> <hash:sub[:hex image]>...");
+        std::process::exit(2);
+    }
+    let w = d1_oracle::world_sensors::derive_cached(hex(&a[0]), a[1].parse().expect("bubble")).expect("derive");
+    let life = w.lifetime().expect("the world has a lifetime record");
+    let mut init = Vec::new();
+    // `@<file>` = one entry per line (a Windows command line holds ~32 K characters; 45 squad
+    // member values do not fit).
+    let mut entries: Vec<String> = Vec::new();
+    for e in &a[3..] {
+        match e.strip_prefix('@') {
+            Some(path) => entries.extend(
+                std::fs::read_to_string(path).expect("entry file").lines().map(str::trim)
+                    .filter(|l| !l.is_empty()).map(String::from),
+            ),
+            None => entries.push(e.clone()),
+        }
+    }
+    for e in &entries {
+        let f: Vec<&str> = e.split(':').collect();
+        let (hash, sub) = (hex(f[0]), f[1].parse::<i16>().expect("sub"));
+        let slot = w
+            .slots
+            .iter()
+            .find(|s| s.name_hash == hash && s.sub == sub)
+            .unwrap_or_else(|| panic!("no sensor slot {hash:#010x} sub {sub} in this bubble"));
+        let value = f.get(2).map(|h| {
+            let img: Vec<u8> = (0..h.len() / 2).map(|i| u8::from_str_radix(&h[2 * i..2 * i + 2], 16).unwrap()).collect();
+            (slot.value_tag, img)
+        });
+        init.push(SensorInitEntry {
+            name_hash: hash,
+            name_i8: slot.kind,
+            name_sub: sub,
+            has_part2: slot.part2_tag.is_some(),
+            value,
+            no_value_part: slot.value_tag == u32::MAX,
+        });
+    }
+    let frame = SensorPhaseUpdate {
+        gen: 0,
+        name_hash: life.name_hash,
+        name_i8: life.kind,
+        name_sub: life.sub,
+        // SENSOR_FRAME_PHASE / SENSOR_FRAME_TOD: experiment with other lifetime phases on a live
+        // client (default: phase 3, the value the host already sent).
+        phase: std::env::var("SENSOR_FRAME_PHASE").ok().and_then(|v| v.parse().ok()).unwrap_or(3),
+        tail: None,
+        init,
+        time_of_day: std::env::var("SENSOR_FRAME_TOD").ok().and_then(|v| v.parse().ok()),
+        authority: None,
+    }
+    .encode()
+    .expect("encode");
+    // write under a temporary name so the host never reads a half-written file
+    let tmp = format!("{}.tmp", a[2]);
+    std::fs::write(&tmp, &frame).expect("write");
+    std::fs::rename(&tmp, &a[2]).expect("rename");
+    println!("{} bytes -> {}", frame.len(), a[2]);
+}
