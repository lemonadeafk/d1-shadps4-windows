+/// The account object with the client's own block written back into it.
+///
+/// Investment **701** is the client uploading its account-level state: schema `0x80801716`,
+/// 1088 bytes, the very structure that sits at `+0x80` of the account object (`0x808018C7`).
+/// It holds, among other things, a 32-bit set of the announcements the player has dismissed
+/// (`+0x404` of the block - three "X OK" pop-ups in orbit set three bits, measured 2026-10-13).
+/// An account that always carries an empty block shows every announcement on every login.
+///
+/// `D1_CLIENT_STATE_DIR/701.bin` is the latest upload (the responder keeps it), and
+/// `D1_OBJECT_FILE` names d1-oracle's `object_file` example: both objects go through the
+/// client's own codec (decode account, decode the upload, copy 1088 bytes, encode). Without
+/// either variable, or on any failure, the account is returned unchanged.
+pub fn with_client_state(rsat: Vec<u8>) -> Vec<u8> {
+    const BLOCK_AT: usize = 0x80;
+    const BLOCK_SIZE: usize = 1088;
+    let (Ok(dir), Ok(exe)) = (std::env::var("D1_CLIENT_STATE_DIR"), std::env::var("D1_OBJECT_FILE")) else {
+        return rsat;
+    };
+    let Ok(upload) = std::fs::read(format!("{dir}/701.bin")) else { return rsat };
+    if upload.len() < 3 {
+        return rsat;
+    }
+    let tmp = std::env::temp_dir();
+    let path = |n: &str| tmp.join(format!("d1-acct-{}-{n}", std::process::id()));
+    let run = |args: &[&std::ffi::OsStr]| {
+        std::process::Command::new(&exe).args(args).output().map(|o| o.status.success()).unwrap_or(false)
+    };
+    let (acct_bin, acct_img, up_bin, up_img, out_bin) =
+        (path("a.bin"), path("a.img"), path("u.bin"), path("u.img"), path("o.bin"));
+    let patched = (|| {
+        std::fs::write(&acct_bin, &rsat).ok()?;
+        std::fs::write(&up_bin, &upload[2..]).ok()?; // after the u16 message id
+        run(&["decode".as_ref(), "0x808018c7".as_ref(), acct_bin.as_os_str(), acct_img.as_os_str()]).then_some(())?;
+        run(&["decode".as_ref(), "0x808016dd".as_ref(), up_bin.as_os_str(), up_img.as_os_str()]).then_some(())?;
+        let mut image = std::fs::read(&acct_img).ok()?;
+        let block = std::fs::read(&up_img).ok()?;
