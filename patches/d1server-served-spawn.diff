+++ b/d1-server/crates/d1-oracle/examples/content_grep.rs
@@ -0,0 +1,28 @@
+// Find a byte pattern in package entries.   content_grep <hex bytes> <package-name substring>...
+fn main() {
+    let mut a = std::env::args().skip(1);
+    let hex = a.next().expect("hex pattern");
+    let pat: Vec<u8> = (0..hex.len() / 2).map(|i| u8::from_str_radix(&hex[2 * i..2 * i + 2], 16).unwrap()).collect();
+    let subs: Vec<String> = a.collect();
+    let mut c = d1_oracle::oodle::Content::open_default().expect("content");
+    let pkgs: Vec<(String, u32)> = c
+        .estate()
+        .packages
+        .iter()
+        .filter(|p| subs.iter().any(|s| p.name.contains(s.as_str())))
+        .map(|p| (p.name.clone(), p.entries().count() as u32))
+        .collect();
+    for (name, n) in pkgs {
+        let mut hits = 0;
+        for idx in 0..n {
+            let Ok((class, b)) = c.entry_bytes(&name, idx) else { continue };
+            if let Some(o) = b.windows(pat.len()).position(|w| w == pat.as_slice()) {
+                hits += 1;
+                if hits <= 6 {
+                    println!("{name} entry {idx} class {class:#010x} size {} at {o:#x}", b.len());
+                }
+            }
+        }
+        eprintln!("{name}: {n} entries, {hits} hits");
+    }
+}
