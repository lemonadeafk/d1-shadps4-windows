diff --git a/d1-server/crates/d1-oracle/src/world_sensors.rs b/d1-server/crates/d1-oracle/src/world_sensors.rs
new file mode 100644
index 0000000..98bf442
--- /dev/null
+++ b/d1-server/crates/d1-oracle/src/world_sensors.rs
@@ -0,0 +1,213 @@
+// SPDX-FileCopyrightText: Copyright 2026 Destiny 1 Preservation Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+//! ⭐ A world's replicated sensor slots, **derived from content** instead of read out of a running
+//! client.
+//!
+//! The activity host must send the initial state of every authority sensor slot (the client's
+//! setter post-pass `FUN_002D0B70` waits for all of them), the lifetime phase on the lifetime
+//! record, and the player-slot values. Until 2026-10-10 those names were measured live. They are
+//! all content:
+//!
+//! ```text
+//! world record (scenario, e.g. city_tower_default1 0x80C7A005, class 0x8106216F)
+//!   +0x0C  activity checksum (the value D1_AH_ACTIVITY_CHECKSUM carries)
+//!   +0x70  bubble count, +0x80 bubble table {u32 region hash, u64 1, u64 off} stride 0x18
+//!          bubble body at entry + off + 0x50: {u32 region hash, u32 bubble content tag}
+//! bubble content (class 0x808008F0) -> bubble definition -> group tags (class 0x8080076E)
+//! group (one package entry): +0x0C group hash, u16 +0x10 replicated count,
+//!   +0x50 member count, members @+0x60 stride 0x10: {u32 kind, u32 _, u32 _, u32 _}
+//! record entries: the record's own name-ref {u32 group hash, u8 kind, u8 0, i16 sub} is embedded,
+//!   followed at +0x14 by the part-2 value tag (-1 = none) and at +0x18 by the value tag
+//!   (the arguments FUN_00107B10 passes to the slot initialiser FUN_002CF060).
+//! ```
+//!
+//! The groups a world loads are the INITIAL bubble's (`FUN_00345250` installs exactly that list
+//! via `FUN_00106D60`; measured on the Tower: bubble 0's definition lists the five loaded groups).
+//! A member only becomes a sensor slot when its record names a value tag; measured: the Tower's
+//! kind-9 member of group `f2d88bd0` has no slot.
+
+use crate::error::{OracleError, Result};
+use crate::oodle::Content;
+
+/// Class of a group entry.
+pub const GROUP_CLASS: u32 = 0x8080_076E;
+/// Class of a globals record entry (lifetime, players, squads, objectives ... all measured).
+pub const RECORD_CLASS: u32 = 0x8080_0861;
+/// Kind of the activity lifetime record (the phase setter's record).
+pub const KIND_LIFETIME: u8 = 0x10;
+/// Kind of a player-slot record.
+pub const KIND_PLAYER_SLOT: u8 = 12;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SensorSlot {
+    pub name_hash: u32,
+    pub kind: u8,
+    pub sub: i16,
+    /// Value schema (slot `+0x0C`).
+    pub value_tag: u32,
+    /// Second part's schema (slot `+0x08`); `None` = no second part.
+    pub part2_tag: Option<u32>,
+}
+
+#[derive(Debug, Clone)]
+pub struct WorldSensors {
+    pub checksum: u32,
+    pub bubble_hashes: Vec<u32>,
+    pub group_hashes: Vec<u32>,
+    pub slots: Vec<SensorSlot>,
+}
+
+impl WorldSensors {
+    pub fn lifetime(&self) -> Option<&SensorSlot> {
+        self.slots.iter().find(|s| s.kind == KIND_LIFETIME)
+    }
+    pub fn player_slots(&self) -> impl Iterator<Item = &SensorSlot> {
+        self.slots.iter().filter(|s| s.kind == KIND_PLAYER_SLOT)
+    }
+}
+
+fn u32_at(b: &[u8], o: usize) -> Option<u32> {
+    b.get(o..o + 4).map(|s| u32::from_le_bytes(s.try_into().unwrap()))
+}
+
+fn shape(msg: String) -> OracleError {
+    OracleError::Shape(msg)
+}
+
+/// Tags of `prefix` (the world package's tag high half) referenced anywhere in `b`.
+fn refs(b: &[u8], prefix: u32) -> Vec<u32> {
+    (0..b.len().saturating_sub(3))
+        .step_by(4)
+        .filter_map(|o| u32_at(b, o))
+        .filter(|v| v >> 16 == prefix)
+        .collect()
+}
+
+/// Derive the sensor slots of `world_tag`, loading into bubble `initial_bubble`.
+pub fn derive(content: &mut Content, world_tag: u32, initial_bubble: usize) -> Result<WorldSensors> {
+    let prefix = world_tag >> 16;
+    let (pkg, _, _, world) = content.entry_bytes_for_tag(world_tag)?;
+    let checksum = u32_at(&world, 0x0C).ok_or_else(|| shape("world record too short".into()))?;
+    let count = u32_at(&world, 0x70).unwrap_or(0) as usize;
+    let mut bubble_hashes = Vec::new();
+    let mut bubble_content = Vec::new();
+    for i in 0..count {
+        let e = 0x80 + i * 0x18;
+        let hash = u32_at(&world, e).ok_or_else(|| shape(format!("bubble {i} out of range")))?;
+        let off = u32_at(&world, e + 0x10).unwrap_or(0) as usize;
+        let body = e + off + 0x50;
+        if u32_at(&world, body) != Some(hash) {
+            return Err(shape(format!(
+                "bubble {i} ({hash:#010x}): body at {body:#x} does not repeat the hash - the world \
+                 record layout assumed here does not hold"
+            )));
+        }
+        bubble_hashes.push(hash);
+        bubble_content.push(u32_at(&world, body + 4).unwrap_or(u32::MAX));
+    }
+    let content_tag = *bubble_content
+        .get(initial_bubble)
+        .ok_or_else(|| shape(format!("no bubble {initial_bubble} (world has {count})")))?;
+
+    // bubble content -> its definition -> the definition's groups
+    let (_, _, _, bc) = content.entry_bytes_for_tag(content_tag)?;
+    let def = *refs(&bc, prefix)
+        .first()
+        .ok_or_else(|| shape(format!("bubble content {content_tag:#010x} names no definition")))?;
+    let (_, _, _, defb) = content.entry_bytes_for_tag(def)?;
+    struct Group {
+        hash: u32,
+        members: Vec<u8>, // kinds of the replicated members, index = sub
+    }
+    let mut groups = Vec::new();
+    // bytes whose tag references name the packages holding the records
+    let mut referrers: Vec<Vec<u8>> = vec![defb.clone()];
+    for t in refs(&defb, prefix) {
+        let (_, _, class, g) = content.entry_bytes_for_tag(t)?;
+        if class != GROUP_CLASS {
+            continue;
+        }
+        let hash = u32_at(&g, 0x0C).unwrap_or(0);
+        if groups.iter().any(|x: &Group| x.hash == hash) {
+            continue;
+        }
+        let rep = g.get(0x10..0x12).map_or(0, |s| u16::from_le_bytes([s[0], s[1]])) as usize;
+        let n = u32_at(&g, 0x50).unwrap_or(0) as usize;
+        let members = (0..rep.min(n)).map(|k| u32_at(&g, 0x60 + k * 0x10).unwrap_or(0) as u8).collect();
+        groups.push(Group { hash, members });
+        referrers.push(g);
+    }
+
+    // Every record of the packages this bubble draws on: the world's own package plus each
+    // package its definition and groups reference (the Tower's squads/objectives group 8d3f1166 is listed
+    // from the activities package but its records live in the ambient-activities package).
+    let mut pkg_names = vec![pkg.clone()];
+    for (r, o) in referrers
+        .iter()
+        .flat_map(|r| (0..r.len().saturating_sub(3)).step_by(4).map(move |o| (r, o)))
+    {
+        let v = u32_at(r, o).unwrap();
+        // content tags are 0x80xxxxxx; 0x8080xxxx / 0x8106xxxx are schema and class tags
+        if v >> 24 != 0x80 || v >> 16 == 0x8080 {
+            continue;
+        }
+        let id = d1_pkg::tag_pkg(v);
+        if id < 0 || id > i32::from(u16::MAX) {
+            continue;
+        }
+        if let Ok(i) = content.newest_index(id as u16) {
+            let name = content.estate().packages[i].name.clone();
+            if !pkg_names.contains(&name) {
+                pkg_names.push(name);
+            }
+        }
+    }
+    let mut slots: Vec<SensorSlot> = Vec::new();
+    for pkg in &pkg_names {
+        // The class is in the entry table, so only record entries are ever decompressed.
+        let records: Vec<u32> = content
+            .estate()
+            .find(pkg)
+            .ok_or_else(|| shape(format!("package {pkg} vanished")))?
+            .entries()
+            .filter(|e| e.class_tag == RECORD_CLASS)
+            .map(|e| e.index)
+            .collect();
+        for idx in records {
+            let Ok((_, b)) = content.entry_bytes(pkg, idx) else { continue };
+            for o in (0..b.len().saturating_sub(0x1C)).step_by(4) {
+                let h = u32_at(&b, o).unwrap();
+                let Some(g) = groups.iter().find(|g| g.hash == h) else { continue };
+                let kind = b[o + 4];
+                let sub = i16::from_le_bytes([b[o + 6], b[o + 7]]);
+                if b[o + 5] != 0 || sub < 0 || g.members.get(sub as usize) != Some(&kind) {
+                    continue;
+                }
+                // a record's OWN name is followed by its value tags; a mere reference to another
+                // record is not (measured: the lifetime record also names {group, 0x11, 1} at
+                // +0x790, followed by an array header). One entry may define several records.
+                let value_tag = u32_at(&b, o + 0x18).unwrap();
+                let part2 = u32_at(&b, o + 0x14).unwrap();
+                if value_tag >> 20 == 0x808
+                    && !slots.iter().any(|s| s.name_hash == h && s.sub == sub)
+                {
+                    slots.push(SensorSlot {
+                        name_hash: h,
+                        kind,
+                        sub,
+                        value_tag,
+                        part2_tag: (part2 != u32::MAX).then_some(part2),
+                    });
+                }
+            }
+        }
+    }
+    slots.sort_by_key(|s| (groups.iter().position(|g| g.hash == s.name_hash), s.sub));
+    Ok(WorldSensors {
+        checksum,
+        bubble_hashes,
+        group_hashes: groups.iter().map(|g| g.hash).collect(),
+        slots,
+    })
+}
