+/// `D1_MM_TUNING=8=4,2=16,10=0.5` - fields of msg 43 `f4.1`, the matchmaking **tuning** message
+/// (descriptor `0x15B48B0`: f1-f4 u32, f5 u8, f6-f9 u32, f10/f11 f32). The client memcpy's the
+/// decoded configuration to `matchmaking_iface+0x38` and `0x5990B0` copies the eleven values into
+/// every matchmaking properties struct: f1->+0x08, f2->+0x98, f3->+0x58, f4->+0xB8, f5->+0x64,
+/// f6->+0x5C, f7->+0x60, **f8->+0xB0**, f9->+0xB4, f10->+0x130, f11->+0x40 (read live 2026-10-10).
+/// ⭐ f8 is the **big-party size**: `0xB09FEA` counts a party as "big" when `size >= props+0xB0`,
+/// and `0xB0A720` refuses with `big-party-count-exceeds-teams` when that count exceeds
+/// `props+0xC4` (0 for the Tower). With the empty `f4.1` stub f8 is 0, every solo player is a big
+/// party, and `setup:matchmaking` loops forever. Unset = the old empty stub.
+fn mm_tuning_configuration() -> Option<Vec<u8>> {
+    let spec = std::env::var("D1_MM_TUNING").ok().filter(|v| !v.trim().is_empty())?;
+    let mut inner = Vec::new();
+    let mut fields: Vec<(u32, &str)> = spec
+        .split(',')
+        .filter_map(|kv| kv.split_once('=').and_then(|(k, v)| Some((k.trim().parse().ok()?, v.trim()))))
+        .filter(|(k, _)| (1..=11).contains(k))
+        .collect();
+    fields.sort_by_key(|(k, _)| *k);
+    for (field, value) in fields {
+        if field >= 10 {
+            inner.push((field << 3 | 5) as u8); // fixed32
+            inner.extend_from_slice(&value.parse::<f32>().ok()?.to_le_bytes());
+        } else {
+            inner.push((field << 3) as u8); // varint
+            let mut v: u64 = value.parse().ok()?;
+            loop {
+                let byte = (v & 0x7F) as u8;
+                v >>= 7;
+                inner.push(if v == 0 { byte } else { byte | 0x80 });
+                if v == 0 {
+                    break;
+                }
+            }
+        }
+    }
+    // f4 body = { f4.1: tuning }. Lengths here are far below 128, so one length byte is enough.
+    let mut cfg = vec![0x0A, inner.len() as u8];
+    cfg.extend_from_slice(&inner);
+    Some(cfg)
+}
