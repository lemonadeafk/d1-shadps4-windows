diff --git a/d1-server/crates/d1-activity-host/src/mission.rs b/d1-server/crates/d1-activity-host/src/mission.rs
new file mode 100644
index 0000000..d5c7f1d
--- /dev/null
+++ b/d1-server/crates/d1-activity-host/src/mission.rs
@@ -0,0 +1,206 @@
+// SPDX-FileCopyrightText: Copyright 2026 Destiny 1 Preservation Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+//! ⭐ The mission engine: a mission's script played by the host itself, reacting to what the
+//! client reports.
+//!
+//! The mission scripts of the original service never shipped with the client: the content holds
+//! only the records (squads, triggers, objectives, sequences ...), not what makes one follow
+//! another. So the script is authored (`tools/mission_compile.py` in the Windows glue turns an
+//! event script into this form) and this module plays it.
+//!
+//! `D1_AH_MISSION=<dir>/mission.txt`, tab-separated, one item per line:
+//!
+//! ```text
+//! cue   start                       runs when the client sends its first sense update
+//! cue   <group hex>:<kind>:<sub>     runs the first time the client reports that record
+//! cue   <group hex>:<kind>:<sub>:changed   ... reported with a value different from the one it
+//!                                    had once its arrival frames were over (30 s after first seen)
+//! <seconds>  frame  <file>  <label>  a finished udt-5 frame in <dir>, sent that long after the cue
+//! <seconds>  fire   <cue>   <label>  start another cue (if it has not run)
+//! <seconds>  file   <file>  <dst>  <label>   copy <dir>/<file> to <dst> (e.g. a loadout swap)
+//! ```
+//!
+//! A step with delay 0 goes out with the very frame whose report started the cue - the client
+//! sees the reaction one round trip after it acted. Frames are encoded before the run starts, so
+//! nothing is built while the player waits.
+
+use std::collections::{HashMap, HashSet};
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub enum Cue {
+    Start,
+    Report { group: u32, kind: u8, sub: u16, changed: bool },
+}
+
+#[derive(Debug, Clone)]
+enum Action {
+    Frame(Vec<u8>),
+    Fire(Cue),
+    File { src: PathBuf, dst: PathBuf },
+}
+
+#[derive(Debug, Clone)]
+struct Step {
+    delay: Duration,
+    action: Action,
+    label: String,
+}
+
+/// What the engine wants sent or done now.
+#[derive(Debug)]
+pub enum Output {
+    Frame { payload: Vec<u8>, label: String },
+}
+
+#[derive(Debug)]
+pub struct Mission {
+    cues: Vec<(Cue, Vec<Step>)>,
+    fired: HashSet<Cue>,
+    pending: Vec<(Instant, Step)>,
+    /// For "changed" cues: when the record was first reported, and its settled value bits.
+    first_seen: HashMap<(u32, u8, u16), Instant>,
+    settled: HashMap<(u32, u8, u16), Vec<u8>>,
+    started: bool,
+}
+
+fn parse_cue(s: &str) -> Option<Cue> {
+    if s == "start" {
+        return Some(Cue::Start);
+    }
+    let p: Vec<&str> = s.split(':').collect();
+    if p.len() < 3 {
+        return None;
+    }
+    Some(Cue::Report {
+        group: u32::from_str_radix(p[0].trim_start_matches("0x"), 16).ok()?,
+        kind: p[1].parse().ok()?,
+        sub: p[2].parse().ok()?,
+        changed: p.get(3) == Some(&"changed"),
+    })
+}
+
+impl Mission {
+    pub fn load(path: &Path) -> anyhow::Result<Self> {
+        let dir = path.parent().unwrap_or(Path::new("."));
+        let text = std::fs::read_to_string(path)?;
+        let mut cues: Vec<(Cue, Vec<Step>)> = Vec::new();
+        for (n, line) in text.lines().enumerate() {
+            let f: Vec<&str> = line.split('\t').collect();
+            if f.is_empty() || f[0].trim().is_empty() || f[0].starts_with('#') {
+                continue;
+            }
+            if f[0] == "cue" {
+                let cue = f.get(1).and_then(|c| parse_cue(c))
+                    .ok_or_else(|| anyhow::anyhow!("mission line {}: bad cue", n + 1))?;
+                cues.push((cue, Vec::new()));
+                continue;
+            }
+            let delay: f64 = f[0].parse().map_err(|_| anyhow::anyhow!("mission line {}: bad delay", n + 1))?;
+            let action = match (f.get(1).copied(), f.get(2).copied()) {
+                (Some("frame"), Some(file)) => Action::Frame(std::fs::read(dir.join(file))?),
+                (Some("fire"), Some(c)) => Action::Fire(
+                    parse_cue(c).ok_or_else(|| anyhow::anyhow!("mission line {}: bad cue", n + 1))?,
+                ),
+                (Some("file"), Some(src)) => Action::File {
+                    src: dir.join(src),
+                    dst: PathBuf::from(f.get(3).copied().unwrap_or_default()),
+                },
+                _ => anyhow::bail!("mission line {}: unknown step", n + 1),
+            };
+            let label = f.last().copied().unwrap_or_default().to_string();
+            let Some(last) = cues.last_mut() else { anyhow::bail!("mission line {}: step before any cue", n + 1) };
+            last.1.push(Step { delay: Duration::from_secs_f64(delay.max(0.0)), action, label });
+        }
+        Ok(Self {
+            cues,
+            fired: HashSet::new(),
+            pending: Vec::new(),
+            first_seen: HashMap::new(),
+            settled: HashMap::new(),
+            started: false,
+        })
+    }
+
+    pub fn cue_count(&self) -> usize {
+        self.cues.len()
+    }
+
+    fn fire(&mut self, cue: &Cue, now: Instant) {
+        if self.fired.contains(cue) {
+            return;
+        }
+        // every block written for this cue (a compiled script may have several)
+        let steps: Vec<Step> = self.cues.iter().filter(|(c, _)| c == cue).flat_map(|(_, s)| s.clone()).collect();
+        if steps.is_empty() {
+            return;
+        }
+        self.fired.insert(cue.clone());
+        tracing::info!("⭐ mission: cue {cue:?} ({} steps)", steps.len());
+        for s in steps {
+            self.pending.push((now + s.delay, s));
+        }
+    }
+
+    /// A udt-6 sense update or udt-18 incident from the client.
+    pub fn on_report(&mut self, payload: &[u8], now: Instant) {
+        if !self.started {
+            self.started = true;
+            self.fire(&Cue::Start, now);
+        }
+        let bits: Vec<u8> = payload.iter().flat_map(|b| (0..8).rev().map(move |i| (b >> i) & 1)).collect();
+        let watched: Vec<Cue> = self.cues.iter().map(|(c, _)| c.clone()).filter(|c| !self.fired.contains(c)).collect();
+        for cue in watched {
+            let Cue::Report { group, kind, sub, changed } = cue else { continue };
+            // name reference, 55 bits MSB first: u32 group, 7 bits kind + 1, 16 bits sub + 0x8000
+            let want = ((group as u64) << 23) | ((kind as u64 + 1) << 16) | (sub as u64 + 0x8000);
+            let at = (bits.len() >= 55)
+                .then(|| (0..=bits.len() - 55).find(|&a| bits[a..a + 55].iter().fold(0u64, |v, b| (v << 1) | *b as u64) == want))
+                .flatten();
+            let Some(at) = at else { continue };
+            if !changed {
+                self.fire(&cue, now);
+                continue;
+            }
+            // the value that follows the reference (up to 48 bits) stands in for the value
+            let value: Vec<u8> = bits[at + 55..(at + 55 + 48).min(bits.len())].to_vec();
+            let key = (group, kind, sub);
+            let first = *self.first_seen.entry(key).or_insert(now);
+            if now.duration_since(first) < Duration::from_secs(30) {
+                self.settled.insert(key, value);
+            } else if self.settled.get(&key).is_some_and(|v| *v != value) {
+                self.fire(&cue, now);
+            } else {
+                self.settled.entry(key).or_insert(value);
+            }
+        }
+    }
+
+    /// Everything due now, in order.
+    pub fn due(&mut self, now: Instant) -> Vec<Output> {
+        let mut out = Vec::new();
+        loop {
+            self.pending.sort_by_key(|(t, _)| *t);
+            let Some(pos) = self.pending.iter().position(|(t, _)| *t <= now) else { break };
+            let (_, step) = self.pending.remove(pos);
+            match step.action {
+                Action::Frame(payload) => {
+                    tracing::info!("⭐ mission: {}", step.label);
+                    out.push(Output::Frame { payload, label: step.label });
+                }
+                Action::Fire(cue) => {
+                    tracing::info!("⭐ mission: {} (fires {cue:?})", step.label);
+                    self.fire(&cue, now);
+                }
+                Action::File { src, dst } => {
+                    let tmp = dst.with_extension("tmp");
+                    let ok = std::fs::copy(&src, &tmp).and_then(|_| std::fs::rename(&tmp, &dst)).is_ok();
+                    tracing::info!("⭐ mission: {} ({} -> {}: {})", step.label, src.display(), dst.display(), if ok { "ok" } else { "FAILED" });
+                }
+            }
+        }
+        out
+    }
