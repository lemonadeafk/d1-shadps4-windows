+            return None;
+        }
+        image[BLOCK_AT..BLOCK_AT + BLOCK_SIZE].copy_from_slice(&block);
+        std::fs::write(&acct_img, &image).ok()?;
+        run(&["encode".as_ref(), "0x808018c7".as_ref(), acct_img.as_os_str(), out_bin.as_os_str()]).then_some(())?;
+        std::fs::read(&out_bin).ok().filter(|b| !b.is_empty())
+    })();
+    for f in [&acct_bin, &acct_img, &up_bin, &up_img, &out_bin] {
+        let _ = std::fs::remove_file(f);
+    }
+    patched.unwrap_or(rsat)
 }
 
