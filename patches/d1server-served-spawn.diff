+// Print every printable ASCII run (>= 4 chars) in the given packages' entries, one per line.
+//   content_strings <package-name substring>...
+use std::io::Write;
+fn main() {
+    let subs: Vec<String> = std::env::args().skip(1).collect();
+    let mut c = d1_oracle::oodle::Content::open_default().expect("content");
+    let pkgs: Vec<(String, u32)> = c
+        .estate()
+        .packages
+        .iter()
+        .filter(|p| subs.iter().any(|s| p.name.contains(s.as_str())))
+        .map(|p| (p.name.clone(), p.entries().count() as u32))
+        .collect();
+    let out = std::io::stdout();
+    let mut out = out.lock();
+    for (name, n) in pkgs {
+        for idx in 0..n {
+            let Ok((_, b)) = c.entry_bytes(&name, idx) else { continue };
+            let mut start = None;
+            for (i, &ch) in b.iter().chain(std::iter::once(&0u8)).enumerate() {
+                let ok = ch.is_ascii_alphanumeric() || ch == b'_';
+                match (ok, start) {
+                    (true, None) => start = Some(i),
+                    (false, Some(s)) => {
+                        if i - s >= 4 {
+                            let _ = out.write_all(&b[s..i]);
+                            let _ = out.write_all(b"\n");
+                        }
+                        start = None;
+                    }
+                    _ => {}
+                }
+            }
+        }
+        eprintln!("{name}: {n} entries");
+    }
+}
