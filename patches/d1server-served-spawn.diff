+    /// ⭐ The whole tabulated array: one record per `(region, token)`, then a `-1` terminator.
+    ///
+    /// The client's matcher `FUN_007775B0` scans this array ONCE per transition (when the
+    /// transition starts and resets `sstm+0x3B0`) and again only when the membership's member
+    /// count `+0x00` changes - which a solo session never does. So an answer published *after* the
+    /// client asks arrives too late: measured live 2026-10-10, the client held `{0x18, token 2}` in
+    /// its own copy (`ac+0x3CB8`) and still waited forever. A host has to tabulate ahead: every
+    /// region the player can walk into, with the token the next transition will carry.
+    pub fn set_pah_table(&mut self, records: &[(u32, u8)], peer_index: usize) -> Result<(), AhError> {
+        if peer_index >= Self::PAH_PEER_TOKEN_CAPACITY {
+            return Err(AhError::FieldOverflow {
+                field: "replicate_membership.pah_region.peer_index",
+                len: peer_index + 1,
+                max: Self::PAH_PEER_TOKEN_CAPACITY,
+            });
+        }
+        if records.len() >= Self::PAH_REGION_CAPACITY {
+            return Err(AhError::FieldOverflow {
+                field: "replicate_membership.pah_regions",
+                len: records.len() + 1,
+                max: Self::PAH_REGION_CAPACITY,
+            });
+        }
+        if self.image.len() < Self::PAH_REGIONS + Self::PAH_REGION_CAPACITY * Self::PAH_REGION_STRIDE {
+            return Err(AhError::BadStructSize {
+                user_defined_type: protocol::UDT_REPLICATE_MEMBERSHIP,
+                got: self.image.len(),
+                want: Self::STRUCT_SIZE,
+            });
+        }
+        for (i, &(region_id, token)) in records.iter().enumerate() {
+            let slot = Self::PAH_REGIONS + i * Self::PAH_REGION_STRIDE;
+            self.image[slot + Self::PAH_REGION_ID..slot + Self::PAH_REGION_ID + 4]
+                .copy_from_slice(&region_id.to_le_bytes());
+            self.image[slot + Self::PAH_PEER_TOKENS + peer_index] = token;
+        }
+        let end = Self::PAH_REGIONS + records.len() * Self::PAH_REGION_STRIDE;
+        self.image[end + Self::PAH_REGION_ID..end + Self::PAH_REGION_ID + 4]
+            .copy_from_slice(&u32::MAX.to_le_bytes());
+        Ok(())
+    }
