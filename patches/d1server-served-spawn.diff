new file mode 100644
index 0000000..9903997
--- /dev/null
+++ b/d1-server/crates/d1-oracle/src/runtime_ids.rs
@@ -0,0 +1,71 @@
+// SPDX-FileCopyrightText: Copyright 2026 Destiny 1 Preservation Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+//! ⭐ Field **kind 0x23** - a 64-bit player/peer identifier - and the runtime state its codec needs.
+//!
+//! Kind 0x23 is a leaf in the descriptor tree, but its handler does not pack bits itself
+//! (encode `0x1069640`, entry `[0x18FAB40 + 0x150 + 0x23*8]`):
+//!
+//! ```text
+//! if FUN_0025C9E0()        ; [0x2639AE0] -> obj; obj->vfunc[0] = 0x1D1990: cmp [rdi+0xC],-1; setne
+//!     tag = *[0x19660C0]   ; BSS record 0x28AA1A0 -> 0x80801932 = one kind-6 64-bit leaf (full id)
+//! else
+//!     tag = *[0x19021B0]   ; BSS record 0x2680360 -> 0x808004AC = only byte +1 of the id (8 bits)
+//! jmp 0x2C8FF0(tag, field, bs, 1)
+//! ```
+//!
+//! Both tag records are BSS, filled when the client registers its schemas, so the bare harness
+//! reads 0 and faults. The tags are derived statically by the [`crate::activity_host`] §2 method
+//! (relocation → sorted checksum table → static record → anchored descriptor), never hardcoded.
+//! The live client (2026-10-10, Tower run `SERVED`) has the flag object at `0x2639AE0` with
+//! `+0xC = 0x80A58001` ⇒ **full 64-bit ids**, and BSS records holding exactly these two tags; the
+//! harness is seeded to match.
+
+use d1_eboot::descriptors::Index;
+use d1_eboot::image::Image;
+
+use crate::error::Result;
+use crate::harness::Harness;
+
+/// The descriptor kind of a 64-bit player identifier field.
+pub const KIND_PLAYER_ID: u32 = 0x23;
+
+const FLAG_GLOBAL: u64 = 0x2639AE0;
+/// `obj->vfunc[0]`: `cmp dword [rdi+0xC], -1; setne al; ret`.
+const FLAG_VFUNC: u64 = 0x1D1990;
+const FULL_ID_GLOBAL: u64 = 0x19660C0;
+const COMPACT_ID_GLOBAL: u64 = 0x19021B0;
+
+/// `(runtime_record, tag)` for the full and the compact id schema. Derived once per process: the
+/// derivation walks the whole relocation table and every harness construction needs it.
+fn records(image: &Image, idx: &Index) -> &'static [(u64, u32)] {
+    static CELL: std::sync::OnceLock<Vec<(u64, u32)>> = std::sync::OnceLock::new();
+    CELL.get_or_init(|| {
+        [FULL_ID_GLOBAL, COMPACT_ID_GLOBAL]
+            .iter()
+            .filter_map(|g| crate::activity_host::derive(image, idx, 0, *g, None).ok())
+            .map(|s| (s.runtime_record, s.tag))
+            .collect()
+    })
+}
+
+/// The two id schemas (full, compact) that a kind-0x23 field can re-enter the codec with.
+pub fn tags(image: &Image, idx: &Index) -> Vec<u32> {
+    records(image, idx).iter().map(|(_, t)| *t).collect()
+}
+
+/// Seed the harness like the live client: both BSS tag records, and a flag object whose own
+/// `vfunc[0]` (the client's `0x1D1990`) answers "full 64-bit ids". Permanent scaffolding - call
+/// before the transient mark.
+pub fn seed(h: &mut Harness, image: &Image, idx: &Index) -> Result<()> {
+    for &(record, tag) in records(image, idx) {
+        h.write_u32(record, tag)?;
+    }
+    let vt = h.alloc(0x10)?;
+    h.write_u64(vt, FLAG_VFUNC)?;
+    let obj = h.alloc(0x20)?;
+    h.write_u64(obj, vt)?;
+    h.write_u32(obj + 0xC, 0)?; // != -1 => full ids
+    h.write_u64(FLAG_GLOBAL, obj)?;
+    Ok(())
+}
