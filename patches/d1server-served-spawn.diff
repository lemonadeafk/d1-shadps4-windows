+// ── the investment clock ─────────────────────────────────────────────────────────────────────────
+//
+// `0x80801941` field [1] - the u64 right after the family-5 root, registry element `+0x008` - is the
+// INVESTMENT TIME: signed calendar seconds (Unix UTC). The client's clock (`0x584CB0`) is
+// `element[+8] + elapsed cycles / frequency`, kept in the runtime state `[0x26A3888+8]+0x58`. The
+// pinned bodies send the field PRESENT with value 0, so the client's investment time read
+// "1970 + uptime". Measured 2026-10-10 on Windows: base 0 live, clock advancing from 0.
+// The bit positions are where the client's own codec (`d1-oracle message --tag 0x80801827 --msgid
+// 205 --obj <+0x010 = t>`) puts it: bit 70 of the 205 body, i.e. bit 230 of the 503 argument
+// stream (they share the tail from 503[21] / 205[1]). Presence bit is the one before.
+const INVESTMENT_TIME_BIT_205: usize = 70;
+const INVESTMENT_TIME_BIT_503: usize = 21 * 8 + (INVESTMENT_TIME_BIT_205 - 8);
+
+/// `D1_INVESTMENT_TIME`: unset/`now` = current Unix seconds, `0`/`off` = leave the body alone (the
+/// old behaviour), a number = that fixed time.
+fn investment_time() -> Option<u64> {
+    match std::env::var("D1_INVESTMENT_TIME").ok().as_deref().map(str::trim) {
+        None | Some("") | Some("now") => std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .ok()
+            .map(|d| d.as_secs()),
+        Some("0") | Some("off") => None,
+        Some(v) => v.parse().ok(),
+    }
+}
+
+fn bit_at(body: &[u8], bit: usize) -> bool {
+    body[bit / 8] >> (7 - bit % 8) & 1 == 1
+}
+
+fn set_bit(body: &mut [u8], bit: usize, on: bool) {
+    if on {
+        body[bit / 8] |= 1 << (7 - bit % 8);
+    } else {
+        body[bit / 8] &= !(1 << (7 - bit % 8));
+    }
+}
+
+/// True when `bit-1` is a set presence bit and the 64 bits at `bit` are all zero - the exact shape
+/// the pinned bodies carry. Anything else is a body we did not build, and is left alone.
+fn time_slot_is_zero(body: &[u8], bit: usize) -> bool {
+    bit >= 1 && body.len() * 8 >= bit + 64 && bit_at(body, bit - 1) && (0..64).all(|i| !bit_at(body, bit + i))
+}
+
+/// Write the investment time into a body whose time field is present-and-zero.
+fn splice_investment_time(body: &mut [u8], bit: usize, t: u64) -> bool {
+    if !time_slot_is_zero(body, bit) {
+        return false;
+    }
+    for i in 0..64 {
+        set_bit(body, bit + i, t >> (63 - i) & 1 == 1);
+    }
+    true
+}
+
+/// `D1_MM_TUNING=8=4,2=16,10=0.5` - fields of msg 43 `f4.1`, the matchmaking **tuning** message
+/// (descriptor `0x15B48B0`: f1-f4 u32, f5 u8, f6-f9 u32, f10/f11 f32). The client memcpy's the
+/// decoded configuration to `matchmaking_iface+0x38` and `0x5990B0` copies the eleven values into
+/// every matchmaking properties struct: f1->+0x08, f2->+0x98, f3->+0x58, f4->+0xB8, f5->+0x64,
+/// f6->+0x5C, f7->+0x60, **f8->+0xB0**, f9->+0xB4, f10->+0x130, f11->+0x40 (read live 2026-10-10).
+/// ⭐ f8 is the **big-party size**: `0xB09FEA` counts a party as "big" when `size >= props+0xB0`,
+/// and `0xB0A720` refuses with `big-party-count-exceeds-teams` when that count exceeds
+/// `props+0xC4` (0 for the Tower). With the empty `f4.1` stub f8 is 0, every solo player is a big
+/// party, and `setup:matchmaking` loops forever. Unset = the old empty stub.
+fn mm_tuning_configuration() -> Option<Vec<u8>> {
+    let spec = std::env::var("D1_MM_TUNING").ok().filter(|v| !v.trim().is_empty())?;
+    let mut inner = Vec::new();
+    let mut fields: Vec<(u32, &str)> = spec
+        .split(',')
+        .filter_map(|kv| kv.split_once('=').and_then(|(k, v)| Some((k.trim().parse().ok()?, v.trim()))))
+        .filter(|(k, _)| (1..=11).contains(k))
+        .collect();
+    fields.sort_by_key(|(k, _)| *k);
+    for (field, value) in fields {
+        if field >= 10 {
+            inner.push((field << 3 | 5) as u8); // fixed32
+            inner.extend_from_slice(&value.parse::<f32>().ok()?.to_le_bytes());
+        } else {
+            inner.push((field << 3) as u8); // varint
+            let mut v: u64 = value.parse().ok()?;
+            loop {
+                let byte = (v & 0x7F) as u8;
+                v >>= 7;
+                inner.push(if v == 0 { byte } else { byte | 0x80 });
+                if v == 0 {
+                    break;
+                }
+            }
+        }
+    }
+    // f4 body = { f4.1: tuning }. Lengths here are far below 128, so one length byte is enough.
+    let mut cfg = vec![0x0A, inner.len() as u8];
+    cfg.extend_from_slice(&inner);
+    Some(cfg)
+}
+
+/// `D1_UNLOCK_FLAGS=98,419,440,...` - the unlock-flag indices to grant (all at value 2) instead of
+/// the shipped ten. Why it exists: the ten include **308 and 3389**, and the Tower's requirement
+/// set (hash `0x6291ABC8`, read live 2026-10-10) is `NOT FLAG(3389)` and `NOT FLAG(308)` - with
+/// either set, selecting the Tower in the Director answers "ACTIVITY BANNED - This account is
+/// permanently banned from social spaces". Unset/empty = the shipped ten. The 503 built from a
+/// list carries the anchor account SOID (`0xD100000000000001`).
+fn unlock_flag_override() -> Option<Vec<u16>> {
+    let v = std::env::var("D1_UNLOCK_FLAGS").ok()?;
+    let ix: Vec<u16> = v.split(',').filter_map(|t| t.trim().parse().ok()).collect();
+    (!ix.is_empty()).then_some(ix)
+}
+
+/// [`shared_0x80801941_agrees`] with the investment-time slot zeroed in both bodies: the time is
+/// sampled per call, so two calls may differ by a second without disagreeing about anything else.
+fn served_bodies_agree(b503: &[u8], b205: &[u8]) -> Option<bool> {
