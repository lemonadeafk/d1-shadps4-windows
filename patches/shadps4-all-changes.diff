+/// True for a stencil clear (DB_RENDER_CONTROL.STENCIL_CLEAR_ENABLE) whose stencil write mask
+/// selects only some of the bits.
+static bool IsMaskedStencilClear(const AmdGpu::Regs& regs) {
+    if (!regs.depth_render_control.stencil_clear_enable || !regs.depth_control.stencil_enable ||
+        !regs.depth_buffer.StencilValid()) {
+        return false;
+    }
+    const u8 mask = regs.stencil_ref_front.stencil_write_mask;
+    static u32 seen[8]{};
+    if ((seen[mask >> 5] & (1u << (mask & 31))) == 0) {
+        seen[mask >> 5] |= 1u << (mask & 31);
+        LOG_INFO(Render_Vulkan, "stencil clear with write mask {:#x}, clear value {:#x}", mask,
+                 regs.stencil_clear);
+    }
+    return mask != 0xFF && mask != 0;
+}
