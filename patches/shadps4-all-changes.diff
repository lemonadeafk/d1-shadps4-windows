+// D1-WINDOWS: a file-based trigger for unattended captures. If <user dir>/capture.trigger exists
+// it is deleted and the next frame is captured - no window focus or hotkey needed.
+static void PollCaptureTriggerFile() {
+    static auto last_poll = std::chrono::steady_clock::now();
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last_poll < std::chrono::milliseconds(500)) {
+        return;
+    }
+    last_poll = now;
+    static const auto trigger =
+        Common::FS::GetUserPath(Common::FS::PathType::UserDir) / "capture.trigger";
+    std::error_code ec;
+    if (capture_state == CaptureState::Idle && std::filesystem::exists(trigger, ec)) {
+        std::filesystem::remove(trigger, ec);
+        LOG_WARNING(Common, "RenderDoc capture triggered by {}", trigger.string());
+        capture_state = CaptureState::Triggered;
+    }
+}
+
